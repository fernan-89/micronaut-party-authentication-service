{
  "info": {
    "_postman_id": "b3c5d7e9-2f4a-4b6c-8d0e-3f5a7b9c1d2e",
    "name": "Party Authentication Service - IAM Lifecycle Suite",
    "description": "Enterprise-grade E2E Postman Suite for the Party Authentication Service Domain (BIAN-aligned, ADR-001/005/013/016). Covers the complete User (tenant operator) lifecycle under /party-authentication/v1 (initiate, retrieve, update, control/activate|suspend|deactivate), tenant-scoped and status-filtered listing, mandatory X-Tenant-Id/X-Executor auditing, RFC 7807 error_code assertions, and automated W3C distributed traceparent correlation. Requires an `organisationId` environment variable populated from the Party Reference Data Directory Service Domain (company-service) — every User is scoped to an existing Organisation tenant.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "39879181"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Automatically generate standard W3C traceparent (ADR-010) and X-Trace-Id",
          "function generateHex(len) {",
          "    let result = '';",
          "    const chars = '0123456789abcdef';",
          "    for (let i = 0; i < len; i++) {",
          "        result += chars.charAt(Math.floor(Math.random() * chars.length));",
          "    }",
          "    return result;",
          "}",
          "const traceId = generateHex(32);",
          "const spanId = generateHex(16);",
          "const traceparent = `00-${traceId}-${spanId}-01`;",
          "pm.request.headers.upsert({ key: 'traceparent', value: traceparent });",
          "pm.request.headers.upsert({ key: 'X-Trace-Id', value: traceId });",
          "pm.environment.set('currentTraceId', traceId);"
        ]
      }
    }
  ],
